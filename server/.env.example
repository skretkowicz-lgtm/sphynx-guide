# Copy this file to .env and fill in your own values. Never commit .env.

PORT=3000

# If serving index.html from somewhere other than this server (e.g. opening
# the file directly, or hosting the static site elsewhere), set this to that
# origin so the browser's CORS check allows the request. Leave unset to
# allow any origin.
# ALLOWED_ORIGIN=http://localhost:3000

# Mail is sent through Resend's HTTPS API, not SMTP: Railway and most other
# hosts block outbound SMTP ports, so a direct smtp.gmail.com connection
# just hangs. Create a key at https://resend.com/api-keys.
RESEND_API_KEY=re_your_api_key

# Address mail is sent FROM. This MUST be on a domain verified at
# https://resend.com/domains. Resend's shared onboarding@resend.dev sender
# needs no DNS setup but can only deliver to the address you registered with
# Resend — which silently breaks the confirmation the visitor gets, since
# that one goes to them rather than to you.
MAIL_FROM=kontakt@sphynx.guide

# Public origin of the site, used to link to the privacy notice from the
# confirmation email. Falls back to ALLOWED_ORIGIN, and if neither is set
# the link is simply left out. Deliberately not taken from the request's
# Host header, which a caller controls.
# SITE_URL=https://sphynx.guide

# Where contact form submissions are delivered — your own inbox.
CONTACT_TO=your-mailbox@gmail.com

# Supabase project used to store every submission. Find both values at
# https://supabase.com/dashboard/project/_/settings/api — SUPABASE_URL is
# the "Project URL", SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret
# key (NOT the "anon" public key). The service_role key has full table
# access and must never be sent to the browser or committed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
